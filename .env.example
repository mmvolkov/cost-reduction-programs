# Copy to .env locally; never commit a populated file. Node 22+: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3000
# Default private pilot. Set public explicitly only after budget initialization and HTTPS origin.
AI_ACCESS_MODE=code
# Key is server-only. Code is required only in code mode; never use the API key as access code.
AI_API_KEY=
AI_ACCESS_CODE=
# Required when deployed behind a TLS reverse proxy; exact browser origin, no trailing slash.
# PUBLIC_ORIGIN=https://example.com
# Durable state outside public/; initialize ONCE with npm run ai:init. Compose overrides this path.
AI_STATE_PATH=
# Hard upper bounds are 100/day, 2 concurrent, 1000 output tokens.
AI_DAILY_REQUESTS=100
AI_MAX_CONCURRENT=2
# Soft GLOBAL flood limiter per process; forwarded IP headers are ignored.
AI_REQUESTS_PER_MINUTE=20
AI_MAX_COMPLETION_TOKENS=1000
# Administrator-only optional provider configuration. Never accept these settings from clients.
# AI_ALLOWED_HOSTS=api.example.com
# AI_PROVIDERS_JSON=[{"id":"additional","label":"Additional provider","baseUrl":"https://api.example.com/v1","model":"model-id","apiKeyEnv":"OTHER_AI_API_KEY"}]
# OTHER_AI_API_KEY=
# Set to /cost-reduction-programs for a path-isolated server deployment.
BASE_PATH=
# Exact additional browser origins, only when the Pages frontend calls this backend.
# CORS_ALLOWED_ORIGINS=https://mmvolkov.github.io

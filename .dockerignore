# Allowlist prevents secrets, Git history and workspace artifacts entering the build.
**
!Dockerfile
!.dockerignore
!compose.yaml
!package.json
!server.mjs
!diagnose-ai.mjs
!lib/
!lib/**
!public/
!public/**
!test/
!test/**
!scripts/
!scripts/**
# Optional vendoring tools never enter the Docker build context.
**/node_modules
**/node_modules/**
